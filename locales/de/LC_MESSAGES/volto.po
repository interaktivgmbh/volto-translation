#. Default: "Go to the original"
#: TranslationsMenu / ManageTranslations customization
msgid "volto-translation-go-to-original"
msgstr "Zum Original"

#. Default: "{mapped} replaced by the mapping, {kept} carried over unchanged."
#: components/TranslationReportView
msgid "volto-translation-report-metadata-summary"
msgstr "{mapped} per Mapping ersetzt, {kept} unverändert übernommen."

#. Default: "These fields are not machine translated: their values come from the metadata mapping in the translation settings."
#: components/TranslationReportView
msgid "volto-translation-report-metadata-intro"
msgstr "Diese Felder werden nicht maschinell übersetzt: Ihre Werte kommen aus dem Metadata-Mapping in den Übersetzungs-Einstellungen."

#. Default: "no mapping entry"
#: components/TranslationReportView
msgid "volto-translation-report-no-mapping-entry"
msgstr "kein Mapping-Eintrag"

#. Default: "Machine translation is not available for this content type."
#: components/TranslateView components/TranslationsMenu customizations/volto/components/manage/Multilingual/ManageTranslations
