msgstr "Für {language} gibt es noch keine Übersetzung. Wie soll sie erstellt werden?"

#. Default: "Translation exists!"
#: components/TranslateView
msgid "volto-translation-translation-exists"
msgstr "Übersetzung vorhanden!"

#. Default: "Plone standard translation"
#: components/TranslateView
msgid "volto-translation-mode-manual"
msgstr "Plone Standard Übersetzung"

#. Default: "Opens Plone's translation form. The content is transferred by hand."
#: components/TranslateView
msgid "volto-translation-mode-manual-hint"
msgstr "Öffnet das Übersetzungsformular von Plone. Die Inhalte werden von Hand übertragen."

#. Default: "Translate automatically"
#: components/TranslateView
msgid "volto-translation-mode-machine"
msgstr "Automatisiert übersetzen"

#. Default: "Content and metadata are translated automatically. The result then has to be reviewed editorially."
#: components/TranslateView
msgid "volto-translation-mode-machine-hint"
msgstr "Inhalte und Metaangaben werden automatisch übersetzt. Das Ergebnis muss anschließend redaktionell geprüft werden."

#. Default: "{language} is not offered for automatic translation."
#: components/TranslateView
msgid "volto-translation-not-offered-for-machine"
msgstr "{language} ist für die automatisierte Übersetzung nicht freigegeben."

